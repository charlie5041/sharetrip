{
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "emulators": {
    "firestore": {
      "port": 8080
    },
    "ui": {
      "enabled": false
    },
    "singleProjectMode": true
  },
  "hosting": [
    {
      "site": "tripshare-tw",
      "public": "kmp/composeApp/build/dist/wasmJs/productionExecutable",
      "ignore": [
        "firebase.json",
        "**/.*"
      ],
      "headers": [
        {
          "source": "**",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "no-cache"
            }
          ]
        },
        {
          "source": "**/*.@(ttf|otf|png|wasm)",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "public, max-age=86400"
            }
          ]
        }
      ],
      "rewrites": [
        {
          "source": "**",
          "destination": "/index.html"
        }
      ]
    },
    {
      "site": "tripshare-f6209",
      "public": "tool/old_site",
      "redirects": [
        {
          "source": "**",
          "destination": "https://tripshare-tw.web.app/",
          "type": 301
        }
      ]
    }
  ]
}
