rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Signed in, either with Google or as a guest (Firebase anonymous
    // sign-in). A guest can later link a Google account from the app; linking
    // keeps the uid, so their trips stay theirs.
    function signedIn() {
      return request.auth != null
        && (request.auth.token.firebase.sign_in_provider in ['google.com', 'anonymous']
            || 'google.com' in request.auth.token.firebase.identities);
    }
    function me() { return request.auth.uid; }

    function trip(tripId) {
      return get(/databases/$(database)/documents/trips/$(tripId)).data;
    }
    function isMember(tripId) {
      return signedIn() && me() in trip(tripId).memberUids;
    }

    // users/{uid}: nickname, tripIds, joinCode. Each device owns its own.
    match /users/{uid} {
      allow read, write: if signedIn() && me() == uid;
    }

    // Crashes and 回報問題 from the app. Write-only: people cannot read
    // each other's reports; the project owner reads them in the Firebase Console.
    match /errorReports/{id} {
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(
             ['uid', 'kind', 'message', 'stack', 'version', 'createdAt'])
        && request.resource.data.uid == me()
        && request.resource.data.kind in ['error', 'feedback']
        && request.resource.data.message is string
        && request.resource.data.message.size() <= 2000
        && (!('stack' in request.resource.data)
            || (request.resource.data.stack is string
                && request.resource.data.stack.size() <= 4000))
        && request.resource.data.version is string
        && request.resource.data.version.size() <= 100
        && request.resource.data.createdAt == request.time;
    }

    // Invites are fetched by code (get, never list), so knowing the 8
    // characters is what lets someone in.
    match /invites/{code} {
      allow get: if signedIn();
      allow create: if isMember(request.resource.data.tripId)
        && request.resource.data.keys().hasOnly(['tripId', 'expiresAt', 'createdBy'])
        && request.resource.data.expiresAt is timestamp
        && request.resource.data.createdBy == me();
    }

    match /trips/{tripId} {
      allow read: if signedIn() && me() in resource.data.memberUids;

      allow create: if signedIn()
        && request.resource.data.ownerUid == me()
        && request.resource.data.memberUids == [me()];

      function tripChanged() {
        return request.resource.data.diff(resource.data).affectedKeys();
      }
      function isOwnerNow() {
        return signedIn() && resource.data.ownerUid == me();
      }
      // The owner's app stamps ownerSeenAt (server time) when it opens the
      // trip. An owner not seen for 14 days, or never (trips from before
      // the stamp), may be replaced by any member, so a trip whose owner
      // lost their account doesn't stay ownerless forever.
      function ownerAbsent() {
        return !('ownerSeenAt' in resource.data)
          || resource.data.ownerSeenAt < request.time - duration.value(14, 'd');
      }

      // Members may edit the trip's details. Who is in it (memberUids), who
      // runs it (ownerUid) and the owner's stamp are handled below.
      allow update: if signedIn() && me() in resource.data.memberUids
        && !tripChanged().hasAny(['ownerUid', 'memberUids', 'ownerSeenAt']);

      // The owner changes anything: who is in (always staying in), the
      // stamp (only to now), and may hand the trip to another member.
      allow update: if isOwnerNow()
        && me() in request.resource.data.memberUids
        && request.resource.data.ownerUid in request.resource.data.memberUids
        && (!tripChanged().hasAny(['ownerSeenAt'])
            || request.resource.data.ownerSeenAt == request.time);

      // Leaving: a member who isn't the owner takes out exactly their own uid.
      allow update: if signedIn() && me() in resource.data.memberUids && !isOwnerNow()
        && tripChanged().hasOnly(['memberUids'])
        && request.resource.data.memberUids.toSet()
             == resource.data.memberUids.toSet().difference([me()].toSet());

      // Taking over from an absent owner.
      allow update: if signedIn() && me() in resource.data.memberUids && ownerAbsent()
        && tripChanged().hasOnly(['ownerUid', 'ownerSeenAt'])
        && request.resource.data.ownerUid == me()
        && request.resource.data.ownerSeenAt == request.time;

      allow delete: if signedIn() && resource.data.ownerUid == me();

      // Joining: a non-member adds exactly their own uid, backed by an
      // unexpired invite for this trip whose code they wrote to their user
      // document first — the rules have no other way to see which invite
      // authorised the join without a Cloud Function.
      allow update: if signedIn() && !(me() in resource.data.memberUids)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberUids'])
        && request.resource.data.memberUids.toSet()
             == resource.data.memberUids.toSet().union([me()].toSet())
        && validJoin(tripId);

      function validJoin(tripId) {
        let code = get(/databases/$(database)/documents/users/$(me())).data.joinCode;
        let invite = get(/databases/$(database)/documents/invites/$(code)).data;
        return invite.tripId == tripId && invite.expiresAt > request.time;
      }

      // Everything inside a trip is open to its members. Someone joining
      // writes their own member document in the same batch as the join,
      // so that one checks the trip as it will be after the batch.
      // The owner sets up the list of members; a friend joins by taking a
      // place nobody has taken (uid null), backed by a valid invite.
      match /members/{memberId} {
        function ownerAfter() {
          return getAfter(/databases/$(database)/documents/trips/$(tripId)).data.ownerUid == me();
        }
        function changed() {
          return request.resource.data.diff(resource.data).affectedKeys();
        }

        allow read: if isMember(tripId);
        // Someone holding a valid invite sees which places are still open.
        allow list: if signedIn() && validJoin(tripId);

        // Also covers the batch that creates the trip with its members.
        allow create: if signedIn() && ownerAfter()
          && (request.resource.data.uid == null || request.resource.data.uid == me());

        // The owner renames anyone and frees a place (uid back to null),
        // but cannot hand a place to someone else's uid.
        allow update: if signedIn() && isMember(tripId)
          && trip(tripId).ownerUid == me()
          && (request.resource.data.uid == resource.data.uid
              || request.resource.data.uid == null);
        // Anyone renames themself, or lets go of their place (leaving the
        // trip, or moving to another name) — the name and its expenses stay.
        allow update: if signedIn() && isMember(tripId)
          && resource.data.uid == me()
          && (changed().hasOnly(['name'])
              || (changed().hasOnly(['uid']) && request.resource.data.uid == null));
        // A member moves to an open place, letting go of theirs in the same batch.
        allow update: if signedIn() && isMember(tripId)
          && resource.data.uid == null
          && request.resource.data.uid == me()
          && changed().hasOnly(['uid', 'joinedAt']);
        // Joining: take an open place, in the same batch as the join.
        allow update: if signedIn() && resource.data.uid == null
          && request.resource.data.uid == me()
          && changed().hasOnly(['uid', 'joinedAt'])
          && validJoin(tripId)
          && me() in getAfter(/databases/$(database)/documents/trips/$(tripId)).data.memberUids;

        allow delete: if signedIn() && isMember(tripId)
          && trip(tripId).ownerUid == me();
      }
      match /{sub}/{docId} {
        allow read, write: if sub in ['expenses', 'settlements', 'items', 'checklist',
                        'flights', 'lodgings', 'mahjong', 'mahjongHands']
          && isMember(tripId);
      }
    }
  }
}
